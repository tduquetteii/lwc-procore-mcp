# Public HTTPS base URL of this server, no trailing slash.
# The OAuth discovery metadata is built from it, so it must match the URL clients are given.
PUBLIC_URL=https://your-server.example.com

# From your app in the Procore Developer Portal (production credentials).
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# The Procore company whose data this server exposes (GET /rest/v1.0/companies).
PROCORE_COMPANY_ID=
